# Copy this to .env.local for local dev, or set these in Vercel Project Settings > Environment Variables.

# Postgres connection string - auto-populated if you attach a Neon/Vercel Postgres database.
DATABASE_URL=

# Must be the SAME 64-char hex string as LicenseSecret.VALUE in the plugin's Java source.
# Generate with: openssl rand -hex 32
LICENSE_SECRET_HEX=

# Password for /admin login.
ADMIN_PASSWORD=

# Any long random string, used to sign the admin session cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
